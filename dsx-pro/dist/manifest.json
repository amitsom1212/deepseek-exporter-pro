{
  "manifest_version": 3,
  "name": "DeepSeek 对话导出 Pro",
  "version": "1.1.3",
  "description": "DeepSeek / DSH 对话导出：逐条勾选提问·思考·回答·图片，批量导出到指定文件夹，支持 Markdown 与含可编辑公式的 DOCX，并可接入 AI 按学科归类归档。",
  "minimum_chrome_version": "109",
  "permissions": [
    "downloads",
    "storage",
    "offscreen",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://chat.deepseek.com/*",
    "*://*.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.deepseek.com/*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "DeepSeek 对话导出 Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
